# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini platform configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here


# Google Sheets Question Bank configuration
QUESTION_BANK_STORAGE=sheets
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_GID=0
# GOOGLE_SHEET_RESOURCE_KEY=optional-drive-resource-key
# GOOGLE_SHEET_WORKSHEET=Sheet1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
